# ---------------------------------------------------------------------------
# OptiPrep environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Database (PostgreSQL — Neon in production).
# For local dev you can point at a local Postgres instance.
# Neon example: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/optiprep?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI / Vercel AI SDK (optional — AI Tutor degrades gracefully without it)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Stripe (optional — payments degrade gracefully without keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_PART_BUNDLE=""
STRIPE_PRICE_FULL_BUNDLE=""

# Public site URL (used for SEO/canonical + PWA)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
