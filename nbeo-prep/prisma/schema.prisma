// OptiPrep — NBEO board-prep platform data model
// Datasource: PostgreSQL (Neon in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth) + users
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  attempts         Attempt[]
  srsCards         SrsCard[]
  subscription     Subscription?
  videoProgress    VideoProgress[]
  rubricScores     RubricScore[]
  studyTasks       StudyTask[]
  bookmarks        Bookmark[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Content outline: Part -> Subject -> Topic -> Question -> Option
// ---------------------------------------------------------------------------

enum PartSlug {
  PART_1
  PART_2
  PART_3
}

model Part {
  id           String   @id @default(cuid())
  slug         PartSlug @unique
  number       Int
  title        String
  subtitle     String
  description  String   @db.Text
  // Exam simulator config
  totalItems   Int      @default(0)
  blockCount   Int      @default(1)
  itemsPerBlock Int     @default(50)
  minutesPerBlock Int   @default(60)
  color        String   @default("sky")
  createdAt    DateTime @default(now())

  subjects   Subject[]
  questions  Question[]
  videos     Video[]
  checklists Checklist[]
  resources  Resource[]
  attempts   Attempt[]
  studyTasks StudyTask[]
}

model Subject {
  id        String   @id @default(cuid())
  partId    String
  name      String
  slug      String
  order     Int      @default(0)
  weight    Float    @default(0) // approx % of exam
  blueprint String?  @db.Text
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  topics    Topic[]
  questions Question[]
  videos    Video[]
  resources Resource[]

  @@unique([partId, slug])
  @@index([partId])
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  slug      String
  order     Int      @default(0)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  questions Question[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id          String     @id @default(cuid())
  partId      String
  subjectId   String
  topicId     String?
  stem        String     @db.Text
  explanation String     @db.Text
  reference   String?
  difficulty  Difficulty @default(MEDIUM)
  imageUrl    String?
  isFree      Boolean    @default(false) // sample questions available on free tier
  createdAt   DateTime   @default(now())

  part    Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  options   Option[]
  responses Response[]
  srsCards  SrsCard[]
  bookmarks Bookmark[]

  @@index([partId])
  @@index([subjectId])
  @@index([topicId])
  @@index([difficulty])
  @@index([isFree])
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  responses Response[]

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Practice / exam attempts
// ---------------------------------------------------------------------------

enum AttemptMode {
  TUTORED
  TIMED
  RANDOM
  DAILY
  CUSTOM
  SIMULATOR
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Attempt {
  id          String        @id @default(cuid())
  userId      String
  partId      String?
  mode        AttemptMode
  status      AttemptStatus @default(IN_PROGRESS)
  timeLimitSec Int?
  title       String?
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  part      Part?      @relation(fields: [partId], references: [id], onDelete: SetNull)
  responses Response[]

  @@index([userId])
  @@index([partId])
  @@index([status])
}

model Response {
  id             String    @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOptionId String?
  isCorrect      Boolean?
  flagged        Boolean   @default(false)
  timeSpentSec   Int       @default(0)
  order          Int       @default(0)
  answeredAt     DateTime?

  attempt        Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?   @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Spaced repetition (SM-2)
// ---------------------------------------------------------------------------

model SrsCard {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  easeFactor    Float    @default(2.5)
  intervalDays  Int      @default(0)
  repetitions   Int      @default(0)
  dueDate       DateTime @default(now())
  lapses        Int      @default(0)
  lastReviewedAt DateTime?
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueDate])
}

// ---------------------------------------------------------------------------
// Media + Part 3 clinical skills
// ---------------------------------------------------------------------------

model Video {
  id          String   @id @default(cuid())
  partId      String?
  subjectId   String?
  title       String
  description String   @db.Text
  youtubeId   String
  durationSec Int      @default(0)
  category    String   @default("Lesson")
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  part     Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  progress VideoProgress[]

  @@index([partId])
}

model VideoProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  seconds   Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Checklist {
  id          String   @id @default(cuid())
  partId      String
  title       String
  technique   String
  description String   @db.Text
  videoId     String?
  order       Int      @default(0)
  part        Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  steps       ChecklistStep[]
  rubricScores RubricScore[]

  @@index([partId])
}

model ChecklistStep {
  id          String  @id @default(cuid())
  checklistId String
  order       Int     @default(0)
  text        String  @db.Text
  critical    Boolean @default(false)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model RubricScore {
  id          String   @id @default(cuid())
  userId      String
  checklistId String
  score       Int      @default(0)
  maxScore    Int      @default(0)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Content library (study guides, high-yield sheets, mnemonics, formulas)
// ---------------------------------------------------------------------------

enum ResourceKind {
  STUDY_GUIDE
  HIGH_YIELD
  MNEMONIC
  FORMULA
}

model Resource {
  id        String       @id @default(cuid())
  kind      ResourceKind
  partId    String?
  subjectId String?
  title     String
  slug      String       @unique
  summary   String       @db.Text
  body      String       @db.Text
  tags      String[]     @default([])
  downloadUrl String?
  published Boolean      @default(true)
  createdAt DateTime     @default(now())

  part    Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([kind])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  body        String    @db.Text
  coverImage  String?
  author      String    @default("OptiPrep Team")
  tags        String[]  @default([])
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Study planner / calendar
// ---------------------------------------------------------------------------

model StudyTask {
  id        String   @id @default(cuid())
  userId    String
  partId    String?
  date      DateTime
  title     String
  type      String   @default("study")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  MONTHLY
  PART_BUNDLE
  FULL_BUNDLE
}

enum SubStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 Plan      @default(FREE)
  status               SubStatus @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
