        {
          "linkId": "fb-body",
          "text": "Removal of a foreign body from the cornea or conjunctiva uses anesthetic drops, a slit lamp, and a needle, spud, or burr. A rust ring may need a second visit. Risks include pain, infection, scarring, irregular astigmatism, incomplete removal, perforation (rare), and need for specialist care. Aftercare typically includes an antibiotic drop, pain control, and no contact lenses until the doctor clears you.",
          "type": "display"
        },
        {
          "linkId": "fb-consent",
          "text": "I consent to foreign-body removal and rust-ring debridement if needed.",
          "type": "boolean",
          "required": true
        },
