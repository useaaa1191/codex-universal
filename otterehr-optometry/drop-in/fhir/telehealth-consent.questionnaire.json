          "linkId": "last-name",
          "text": "Last name",
          "type": "string",
          "required": true
        },
        {
          "linkId": "first-name",
          "text": "First name",
          "type": "string",
          "required": true
        },
        {
          "linkId": "tele-body",
          "text": "A telehealth visit cannot replace a comprehensive in-person dilated examination. Remote care is limited by camera quality, lighting, and the inability to measure pressure or view the far retinal periphery. If I have flashes, floaters with a curtain, sudden vision loss, chemical injury, or severe pain I will seek emergency in-person care. I understand state licensure rules: the doctor must be licensed where I am physically located during the visit.",
          "type": "display"
        },
        {
          "linkId": "tele-agree",
          "text": "I consent to telehealth as described.",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "signature",
          "text": "Signature",
          "type": "string",
          "required": true
        },
        {
          "linkId": "sign-date",
          "text": "Date",
          "type": "date",
          "required": true
        }
      ]
